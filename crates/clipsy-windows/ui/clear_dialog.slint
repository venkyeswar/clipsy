// The confirm dialog for clearing history. Rust (src/clear_dialog.rs) sets the question and
// whether Clear is allowed, and clears the store when Clear is clicked. Nothing here deletes anything.

import { Button, CheckBox } from "std-widgets.slint";

export component ClearDialog inherits Window {
    title: "Clear history";
    width: 380px;
    height: 200px;

    // The question, for example "Remove 9 items? 3 pinned items will be kept."
    in-out property <string> message;
    // Ticked means pinned items are removed too. Rust recounts when it changes.
    in-out property <bool> also-pinned: false;
    // False when there is nothing to remove, so Clear is disabled.
    in-out property <bool> can-clear: true;

    callback also-pinned-changed(bool);
    callback clear-requested();
    callback cancel-requested();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "Clear history?";
            font-size: 14px;
            font-weight: 600;
        }
        Text {
            text: root.message;
            wrap: word-wrap;
        }
        CheckBox {
            text: "Also remove pinned items";
            checked <=> root.also-pinned;
            toggled => { root.also-pinned-changed(self.checked); }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: "Cancel";
                clicked => { root.cancel-requested(); }
            }
            Button {
                text: "Clear";
                primary: true;
                enabled: root.can-clear;
                clicked => { root.clear-requested(); }
            }
        }
    }
}
