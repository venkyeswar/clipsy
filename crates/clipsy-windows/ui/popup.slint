// The clipboard history popup. All logic lives in src/popup.rs; this file only lays out
// the window and reports key presses and clicks back to Rust.

export struct RowData {
    preview: string,
    kind: string,
    pinned: bool,
    source: string,
    has-thumb: bool,
    thumb: image,
}

// One filter pill. Rust maps the index it reports (0 = All ... 4 = Pinned).
component FilterTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <color> accent;
    in property <color> muted-color;
    callback clicked();

    height: 26px;
    border-radius: 13px;
    background: root.active ? root.accent : transparent;
    Text {
        text: root.label;
        font-size: 12px;
        color: root.active ? white : root.muted-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// A small text button in the header (Settings, Clear).
component HeaderButton inherits Rectangle {
    in property <string> label;
    in property <color> muted-color;
    in property <color> hover-color;
    callback clicked();

    height: 24px;
    border-radius: 6px;
    background: touch.has-hover ? root.hover-color : transparent;
    Text {
        text: root.label;
        font-size: 12px;
        color: root.muted-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A text button for the clear-history overlay. The colours come from the popup, which knows
// the theme.
component ActionButton inherits Rectangle {
    in property <string> label;
    in property <color> fill;
    in property <color> text-color;
    in property <bool> can-press: true;
    callback clicked();

    width: 84px;
    height: 30px;
    border-radius: 6px;
    background: root.fill;
    opacity: root.can-press ? 1 : 0.4;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        font-size: 12px;
        color: root.text-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        enabled: root.can-press;
        clicked => { root.clicked(); }
    }
}

export component ClipPopup inherits Window {
    title: "Clipsy popup";
    no-frame: true;
    always-on-top: true;
    // Starting size. Rust sets the real size (kept for the session) and clamps it to 320x300..900x1000.
    width: 420px;
    height: 520px;

    in property <[RowData]> rows;
    in-out property <int> selected: 0;
    in-out property <string> query;
    in property <int> filter-index: 0;
    in property <bool> dark: false;
    in property <bool> compact: false;
    // Full text of the selected item for the preview panel. Empty hides the panel.
    in property <string> preview-text;

    // Rust owns the selection: keys ask for a move, and Rust sets `selected` back.
    callback query-edited(string);
    callback filter-picked(int);
    callback move-selection(int);
    callback activate(int, bool);
    callback pin-toggled(int);
    callback delete-requested(int);
    callback preview-toggled(int);
    callback settings-requested();
    callback clear-requested();
    callback hide-requested();
    // The window's size changed by this much (logical px) while the resize grip was dragged.
    callback resize-by(length, length);

    // Clear-history overlay. Rust sets the message and whether Clear is allowed, and handles
    // the confirm. Slint toggles the checkbox and closes the overlay on Cancel and Escape.
    in-out property <bool> clear-open: false;
    in-out property <bool> clear-also-pinned: false;
    in property <string> clear-message;
    in property <bool> clear-can-clear: false;
    callback clear-also-pinned-changed(bool);
    callback clear-confirmed();

    // Last pointer position (window coordinates) while the resize grip is dragged.
    property <length> grip-x;
    property <length> grip-y;

    property <color> bg: root.dark ? #202124 : #ffffff;
    property <color> fg: root.dark ? #f1f3f4 : #202124;
    property <color> muted: root.dark ? #9aa0a6 : #5f6368;
    property <color> field-bg: root.dark ? #2d2e31 : #f1f3f4;
    property <color> row-selected: root.dark ? #3c4043 : #d3e3fd;
    property <color> accent: #3584e4;
    property <length> row-height: root.compact ? 34px : 50px;
    // Gap between rows; the VerticalLayout below uses the same value.
    property <length> row-gap: 2px;

    background: root.bg;

    // Scroll the list so the row at `index` is fully visible.
    function scroll-to-row(index: int) {
        if (index < 0 || index >= root.rows.length) {
            return;
        }
        let top = root.row-height * index + root.row-gap * index;
        let bottom = top + root.row-height;
        if (bottom > -list-view.content-y + list-view.height) {
            list-view.content-y = -(bottom - list-view.height);
        }
        if (top < -list-view.content-y) {
            list-view.content-y = -top;
        }
    }

    changed selected => {
        root.scroll-to-row(root.selected);
    }
    // A new result list starts at the top.
    changed rows => {
        list-view.content-y = 0px;
    }

    forward-focus: search;

    // Fills the whole window, so the list below takes the height the window has.
    VerticalLayout {
        width: root.width;
        height: root.height;
        padding: 12px;
        spacing: 8px;

        // Header: the Clipsy logo and name, the item count, then Settings and Clear.
        HorizontalLayout {
            height: 24px;
            spacing: 6px;
            Image {
                source: @image-url("../assets/clipsy-64.png");
                width: 20px;
                height: 20px;
                image-fit: contain;
            }
            Text {
                text: "Clipsy";
                color: root.fg;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: root.rows.length == 1 ? "1 item" : "\{root.rows.length} items";
                color: root.muted;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            HeaderButton {
                label: "Settings";
                width: 62px;
                muted-color: root.muted;
                hover-color: root.field-bg;
                clicked => { root.settings-requested(); }
            }
            HeaderButton {
                label: "Clear";
                width: 50px;
                muted-color: root.muted;
                hover-color: root.field-bg;
                clicked => { root.clear-requested(); }
            }
        }

        search := TextInput {
            text <=> root.query;
            font-size: 15px;
            color: root.fg;
            height: 36px;
            single-line: true;
            edited => {
                root.query-edited(self.text);
            }
            key-pressed(event) => {
                // While the clear overlay is open, the search box keeps focus and takes the keys:
                // Escape cancels, Enter confirms (when Clear is allowed), and typing is blocked.
                if (root.clear-open) {
                    if (event.text == Key.Escape) {
                        root.clear-open = false;
                        return accept;
                    }
                    if (event.text == Key.Return && root.clear-can-clear) {
                        root.clear-confirmed();
                    }
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.move-selection(-1);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.move-selection(1);
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.activate(root.selected, event.modifiers.shift);
                    return accept;
                }
                if (event.text == Key.Escape) {
                    root.hide-requested();
                    return accept;
                }
                // Delete removes the selected row only while the search box is empty, so it
                // still edits the search text when there is a query.
                if (event.text == Key.Delete && root.query == "" && root.rows.length > 0) {
                    root.delete-requested(root.selected);
                    return accept;
                }
                // Ctrl+P toggles the pin. The control character is accepted too, in case the
                // key event reports Ctrl+P that way.
                if (event.modifiers.control && (event.text == "p" || event.text == "P" || event.text == "\u{10}")) {
                    root.pin-toggled(root.selected);
                    return accept;
                }
                // Space previews the selected item, but only while the search box is empty.
                if (event.text == " " && root.query == "" && root.rows.length > 0) {
                    root.preview-toggled(root.selected);
                    return accept;
                }
                return reject;
            }
        }

        HorizontalLayout {
            height: 26px;
            spacing: 4px;
            FilterTab {
                label: "All";
                active: root.filter-index == 0;
                accent: root.accent;
                muted-color: root.muted;
                clicked => { root.filter-picked(0); }
            }
            FilterTab {
                label: "Text";
                active: root.filter-index == 1;
                accent: root.accent;
                muted-color: root.muted;
                clicked => { root.filter-picked(1); }
            }
            FilterTab {
                label: "Images";
                active: root.filter-index == 2;
                accent: root.accent;
                muted-color: root.muted;
                clicked => { root.filter-picked(2); }
            }
            FilterTab {
                label: "Files";
                active: root.filter-index == 3;
                accent: root.accent;
                muted-color: root.muted;
                clicked => { root.filter-picked(3); }
            }
            FilterTab {
                label: "Pinned";
                active: root.filter-index == 4;
                accent: root.accent;
                muted-color: root.muted;
                clicked => { root.filter-picked(4); }
            }
        }

        // The Rectangle clips the scrolling list to the space left under the tabs.
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            list-view := Flickable {
                width: parent.width;
                height: parent.height;
                content-width: self.width;
                content-height: root.rows.length * root.row-height + root.rows.length * root.row-gap;

                list-box := VerticalLayout {
                    width: parent.width;
                    spacing: root.row-gap;

                    for row[index] in root.rows: Rectangle {
                        height: root.row-height;
                        border-radius: 6px;
                        background: index == root.selected ? root.row-selected : transparent;
                        // The pin and delete buttons show only while the pointer is on the row.
                        property <bool> hovered: row-touch.has-hover || pin-touch.has-hover || delete-touch.has-hover;

                        // The whole row pastes on click. Declared first, so the buttons below sit on top.
                        row-touch := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.activate(index, false); }
                        }

                        // Accent edge on the left of pinned rows.
                        if (row.pinned): Rectangle {
                            x: 0px;
                            y: 6px;
                            width: 2px;
                            height: parent.height - 12px;
                            background: root.accent;
                        }

                        // Kind label, or the image thumbnail for image items.
                        Rectangle {
                            x: 8px;
                            y: 6px;
                            width: 36px;
                            height: parent.height - 12px;
                            border-radius: 4px;
                            background: root.field-bg;
                            if (row.has-thumb): Image {
                                width: parent.width - 4px;
                                height: parent.height - 4px;
                                source: row.thumb;
                                image-fit: contain;
                            }
                            if (!row.has-thumb): Text {
                                text: row.kind == "image" ? "IMG" : row.kind == "files" ? "FILE" : row.kind == "html" ? "HTML" : "TXT";
                                font-size: 9px;
                                color: root.muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            x: 54px;
                            width: parent.width - 124px;
                            text: row.preview;
                            color: root.fg;
                            font-size: 13px;
                            overflow: elide;
                            wrap: no-wrap;
                            vertical-alignment: center;
                        }

                        // Source app label, under the preview (normal row height only).
                        if (!root.compact && row.source != ""): Text {
                            x: 54px;
                            y: parent.height - 18px;
                            width: parent.width - 124px;
                            text: row.source;
                            color: root.muted;
                            font-size: 10px;
                            overflow: elide;
                            wrap: no-wrap;
                        }

                        // Pin star: always shown on pinned rows, outline on hover otherwise.
                        Text {
                            x: parent.width - 62px;
                            width: 24px;
                            height: parent.height;
                            visible: row.pinned || parent.hovered;
                            text: row.pinned ? "★" : "☆";
                            color: row.pinned ? root.accent : root.muted;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        pin-touch := TouchArea {
                            x: parent.width - 62px;
                            width: 24px;
                            height: parent.height;
                            visible: row.pinned || parent.hovered;
                            clicked => { root.pin-toggled(index); }
                        }

                        // Delete button, shown on hover only.
                        Text {
                            x: parent.width - 34px;
                            width: 24px;
                            height: parent.height;
                            visible: parent.hovered;
                            text: "×";
                            color: root.muted;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        delete-touch := TouchArea {
                            x: parent.width - 34px;
                            width: 24px;
                            height: parent.height;
                            visible: parent.hovered;
                            clicked => { root.delete-requested(index); }
                        }
                    }
                }
            }
        }

        // Preview of the selected item (Space). Fixed height; long text scrolls inside it.
        if (root.preview-text != ""): Rectangle {
            height: 160px;
            border-radius: 6px;
            background: root.field-bg;
            clip: true;

            Flickable {
                x: 10px;
                y: 8px;
                width: parent.width - 20px;
                height: parent.height - 16px;
                content-width: self.width;
                content-height: preview-body.height;

                preview-body := Text {
                    width: parent.width;
                    text: root.preview-text;
                    color: root.fg;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }

        Text {
            visible: root.rows.length == 0;
            text: root.query == "" ? "Nothing copied yet" : "No matches";
            color: root.muted;
            font-size: 13px;
            horizontal-alignment: center;
            height: 40px;
        }

        Text {
            text: "Enter paste   Shift+Enter plain   Delete remove";
            color: root.muted;
            font-size: 11px;
            horizontal-alignment: center;
            height: 18px;
        }
    }

    // Resize grip in the bottom-right corner. Dragging it reports the pointer's movement. The
    // pointer is measured in window coordinates, so the grip moving with the window does not
    // change the measurement.
    grip := Rectangle {
        x: root.width - 18px;
        y: root.height - 18px;
        width: 18px;
        height: 18px;
        // Six small dots in a triangle.
        Rectangle { x: 12px; y: 4px; width: 2px; height: 2px; border-radius: 1px; background: root.muted; }
        Rectangle { x: 12px; y: 8px; width: 2px; height: 2px; border-radius: 1px; background: root.muted; }
        Rectangle { x: 8px; y: 8px; width: 2px; height: 2px; border-radius: 1px; background: root.muted; }
        Rectangle { x: 12px; y: 12px; width: 2px; height: 2px; border-radius: 1px; background: root.muted; }
        Rectangle { x: 8px; y: 12px; width: 2px; height: 2px; border-radius: 1px; background: root.muted; }
        Rectangle { x: 4px; y: 12px; width: 2px; height: 2px; border-radius: 1px; background: root.muted; }
        grip-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: nwse-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.grip-x = self.absolute-position.x + self.mouse-x;
                    root.grip-y = self.absolute-position.y + self.mouse-y;
                }
            }
            moved => {
                if (self.pressed) {
                    let now-x = self.absolute-position.x + self.mouse-x;
                    let now-y = self.absolute-position.y + self.mouse-y;
                    root.resize-by(now-x - root.grip-x, now-y - root.grip-y);
                    root.grip-x = now-x;
                    root.grip-y = now-y;
                }
            }
        }
    }

    // Clear-history confirmation. It covers the whole window: the scrim blocks clicks on the
    // list, and the card sits in the middle. The search box keeps focus and handles the keys.
    if (root.clear-open): Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #000000a0;
        // Swallows clicks on the scrim, so nothing behind it is pressed.
        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        Rectangle {
            width: root.width - 40px;
            height: 220px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 10px;
            background: root.bg;
            border-width: 1px;
            border-color: root.field-bg;

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding: 16px;
                spacing: 10px;

                Text {
                    text: "Clear history?";
                    color: root.fg;
                    font-size: 14px;
                    font-weight: 600;
                    height: 20px;
                }
                Text {
                    text: root.clear-message;
                    color: root.fg;
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                // Checkbox row: the whole row toggles it, and the message updates live.
                Rectangle {
                    height: 22px;
                    Rectangle {
                        x: 0px;
                        y: 3px;
                        width: 16px;
                        height: 16px;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: root.muted;
                        background: root.clear-also-pinned ? root.accent : transparent;
                    }
                    Text {
                        x: 24px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text: "Also remove pinned items";
                        color: root.fg;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => {
                            root.clear-also-pinned = !root.clear-also-pinned;
                            root.clear-also-pinned-changed(root.clear-also-pinned);
                        }
                    }
                }
                HorizontalLayout {
                    height: 30px;
                    alignment: end;
                    spacing: 8px;
                    ActionButton {
                        label: "Cancel";
                        fill: root.field-bg;
                        text-color: root.fg;
                        clicked => { root.clear-open = false; }
                    }
                    ActionButton {
                        label: "Clear";
                        fill: root.accent;
                        text-color: white;
                        can-press: root.clear-can-clear;
                        clicked => { root.clear-confirmed(); }
                    }
                }
            }
        }
    }
}
